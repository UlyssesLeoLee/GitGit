{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main window of gitgit Desktop (V0). Every non-core plugin granted here must be imported by the frontend; tests/unit/capability-surface-gate.test.ts asserts that the two sets are equal.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:app:default",
    "core:event:default",
    "core:tray:default",
    "core:menu:default",
    "core:path:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm"
  ]
}
