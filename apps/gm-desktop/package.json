{
  "name": "gm-desktop",
  "private": true,
  "license": "AGPL-3.0",
  "version": "0.1.0",
  "type": "module",
  "description": "Local desktop shell for gitgit MVP (per ADR-0020)",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,html}\" \"tests/**/*.{ts}\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "2",
    "@testing-library/svelte": "^5.2.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.0",
    "eslint": "8.57.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.31",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.4",
    "svelte-preprocess": "^6.0.2",
    "tailwindcss": "^3.4.13",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "yaml": "2.8.3"
  },
  "pnpm": {
    "overrides": {
      "postcss-selector-parser": "7.1.7",
      "minimatch@>=10.0.0 <11.0.0": "11.0.3"
    }
  }
}
