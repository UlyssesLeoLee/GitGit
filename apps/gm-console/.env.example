# gm-console environment example. Copy to .env.local and adjust.
# Base URL used by the axios client in production builds. Leave empty in
# dev to rely on the Vite proxy (/api → VITE_API_PROXY_TARGET).
VITE_API_BASE_URL=

# When running `pnpm dev`, proxy /api/* to this target.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# 'true' (default in dev) → start MSW so the UI runs without a backend.
# 'false' → skip MSW entirely.
VITE_ENABLE_MOCKS=true