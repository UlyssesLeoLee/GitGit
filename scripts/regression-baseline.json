{
  "$comment": "GitGit regression baseline — committed as the 'known-good' contract that scripts/regression-*.ps1 must satisfy. Updating any number here is a deliberate baseline change, not a silent drift; record the rationale in docs/reports/<date>-regression-test/REGRESSION-TEST-REPORT.md.",
  "schemaVersion": "1.0",
  "capturedAt": "2026-09-20",
  "capturedFrom": {
    "branch": "origin/dev",
    "head": "151957d",
    "rustToolchain": "cargo 1.98.1",
    "os": "Windows 11 (git-bash + PowerShell 5.1)"
  },
  "ut": {
    "expectedTotal": 124,
    "expectedPassed": 122,
    "expectedFailed": 0,
    "expectedIgnored": 2,
    "ignoredTest": "server::vault::tests::minio_vault_e2e_roundtrip and server::vault_versioned::tests::minio_vault_versioned_e2e (both require a running minIO server)",
    "perModule": {
      "ai::anthropic": 3,
      "ai::diff": 6,
      "ai::openai": 5,
      "ai::prompt": 3,
      "ai::registry": 6,
      "ai::sanitize": 17,
      "ai::tests": 3,
      "repo::refs": 7,
      "repo::store": 6,
      "server::api": 17,
      "server::auth": 4,
      "server::http": 7,
      "server::smart": 4,
      "server::subprocess": 5,
      "server::vault": 12,
      "server::vault_versioned": 19
    },
    "command": "cargo test --quiet",
    "timeoutSec": 600,
    "rationale": "Per-module values are passed+ignored counts as the tier reports them. Re-agreed 2026-10-03 after the tier became runnable on this box: the previous numbers (76/75/1, written 2026-09-21 in d36d8c4) had drifted because they were cross-checked by hand with grep and never re-run -- server::vault_versioned alone grew from 9 to 13 #[test] fns after that commit, and the ai:: modules did not exist yet. Corroborated two ways: the tier's own parse of `cargo test` and cargo's own summary line both report 122 passed / 2 ignored / 0 failed. This is a count contract, not a coverage gate: it will go red whenever a test is legitimately added, so re-agree it in the same commit that adds the tests."
  },
  "it": {
    "description": "HTTP-level integration tests against a running gitgit server, hitting /api/* via curl. Distinct from ULYS-123's in-process axum oneshot tests in that these run against a real bound socket.",
    "endpoints": [
      { "method": "GET",  "path": "/api/health",                        "expectStatus": 200, "expectJsonContains": ["\"status\":\"ok\"", "\"backend\":\"versioned\"", "\"vault_online\":true"] },
      { "method": "GET",  "path": "/api/repos",                          "expectStatus": 200, "expectJsonShape": "array", "expectArrayLenEq": 2 },
      { "method": "GET",  "path": "/api/repos/does-not-exist",           "expectStatus": 404 },
      { "method": "GET",  "path": "/api/repos/..%2Fescape",              "expectStatus": 400, "expectBodyContains": "invalid repo name" },
      { "method": "GET",  "path": "/api/repos/alpha/refs",               "expectStatus": 200, "expectJsonShape": "array", "minArrayLen": 0 },
      { "method": "GET",  "path": "/api/repos/alpha/log",                "expectStatus": 200, "expectJsonShape": "array" },
      { "method": "GET",  "path": "/api/repos/alpha",                    "expectStatus": 200, "expectJsonContains": ["\"name\":\"alpha\"", "\"path\":", "\"refs\":", "\"log\":"] },
      { "method": "GET",  "path": "/api/vault/keys",                     "expectStatus": 200, "expectJsonShape": "array", "expectArrayLenEq": 0 },
      { "method": "POST", "path": "/api/vault/keys/openai/versions",     "expectStatus": 200, "body": "{\"value\":\"sk-openai-abc\"}", "expectJsonContains": ["\"version\":1", "\"key\":\"openai\""] },
      { "method": "POST", "path": "/api/vault/keys/openai/versions",     "expectStatus": 400, "body": "{\"value\":\"\"}", "expectBodyContains": "value" },
      { "method": "POST", "path": "/api/vault/keys/openai/versions",     "expectStatus": 200, "body": "{\"value\":\"sk-openai-def\"}", "expectJsonContains": ["\"version\":2"] },
      { "method": "GET",  "path": "/api/vault/keys/openai",              "expectStatus": 200, "expectJsonContains": ["\"key\":\"openai\"", "\"current_version\":2"] },
      { "method": "GET",  "path": "/api/vault/keys/openai/versions",     "expectStatus": 200, "expectJsonShape": "object", "expectJsonContains": ["\"key\":\"openai\"", "\"versions\":"] },
      { "method": "GET",  "path": "/api/vault/keys/openai/diff?base=1&head=2", "expectStatus": 200, "expectJsonContains": ["\"base\":", "\"head\":", "\"object_changed\":"] },
      { "method": "POST", "path": "/api/vault/keys/openai/restore",      "expectStatus": 200, "body": "{\"target_version\":1}", "expectJsonContains": ["\"new_version\":"] },
      { "method": "POST", "path": "/api/vault/keys/openai/restore",      "expectStatus": 400, "body": "{\"target_version\":0}", "expectBodyContains": "target_version" },
      { "method": "GET",  "path": "/api/vault/keys/nope",                "expectStatus": 200 },
      { "method": "DELETE","path": "/api/vault/keys/openai",             "expectStatus": 204 }
    ]
  },
  "st": {
    "description": "End-to-end smoke: real git client against the HTTP smart protocol. Wraps scripts/smoke.ps1 unchanged.",
    "command": "pwsh scripts/smoke.ps1",
    "timeoutSec": 180,
    "minAssertions": 7,
    "rationale": "smoke.ps1 asserts: (1) build OK, (2) server ready, (3) first clone, (4) push to main, (5) feature branch push, (6) second clone + merge, (7) unauth push rejected. 7 step-level checks plus negative-auth fallbacks."
  },
  "orchestrator": {
    "command": "pwsh scripts/regression.ps1",
    "tiers": ["ut", "it", "st"],
    "onFailure": "abort (continue-on-fail only with -ContinueOnFail flag)"
  }
}
